---
// One page per way to give (src/data/ways.ts): what the gift does, how to give,
// the projects it supports and the questions people ask — each page answers a
// different search, rather than repeating the Donate page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { ways } from '../../data/ways';
import { getProject } from '../../data/projects';
import { faqsAbout, faqSchema } from '../../data/faq';
import { site } from '../../data/site';

export function getStaticPaths() {
  return ways.map((w) => ({ params: { slug: w.slug }, props: { way: w } }));
}

const { way } = Astro.props;
const projects = way.relatedProjects.map(getProject).filter((p) => p !== undefined);
const others = ways.filter((w) => w.slug !== way.slug);
const questions = faqsAbout('giving');
const siteUrl = Astro.site ?? new URL('https://reach-children-uganda.org.uk');
const pageUrl = new URL(`/donate/${way.slug}/`, siteUrl).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: way.title,
    url: pageUrl,
    description: way.description,
    about: { '@id': new URL('/#organization', siteUrl).href },
    potentialAction: {
      '@type': 'DonateAction',
      name: way.short,
      description: way.lead,
      target: pageUrl,
      recipient: { '@id': new URL('/#organization', siteUrl).href },
    },
  },
  faqSchema(questions),
];
---

<BaseLayout title={way.title} description={way.description} schema={schema}>
  <PageHeader eyebrow="Ways to give" title={way.title} lead={way.lead} />

  <section class="container-reach grid gap-10 py-16 md:grid-cols-5">
    <div class="md:col-span-3">
      <h2 class="text-2xl font-semibold sm:text-3xl">What your gift does</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {way.provides.map((item) => (
          <li class="flex items-start gap-3 rounded-2xl border border-sand-200 bg-white p-4 text-ink-800">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-500"></span>
            {item}
          </li>
        ))}
      </ul>
      <div class="prose-reach mt-8 max-w-none">
        {way.why.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="md:col-span-2">
      <div class="rounded-3xl border border-sand-200 bg-white p-7 text-center">
        {way.amount && (
          <>
            <p class="text-gradient-warm font-display text-5xl font-bold">{way.amount}</p>
            <p class="text-sm text-ink-500">{way.period}</p>
          </>
        )}
        <form action="https://www.paypal.com/donate" method="post" target="_top" class="mt-6">
          <input type="hidden" name="hosted_button_id" value="Z4TJXHTMXUBE2" />
          <button type="submit" class="btn-primary w-full">Donate with PayPal</button>
        </form>
        <p class="mt-4 text-sm leading-relaxed text-ink-600">
          One-off or monthly, by card or PayPal. Prefer to give by cheque, or by card another way?
          <a href="/donate/" class="font-semibold text-accent-700 hover:text-accent-800">All ways to donate</a>.
        </p>
        <p class="mt-3 text-xs text-ink-500">
          UK registered charity {site.charityNumber} · run by unpaid volunteers since 1992
        </p>
      </div>
    </aside>
  </section>

  {projects.length > 0 && (
    <section class="border-t border-sand-200 bg-white">
      <div class="container-reach py-14">
        <h2 class="text-xl font-semibold">Projects your gift supports</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {projects.map((p) => (
            <a href={`/projects/${p!.slug}/`} class="group rounded-2xl border border-sand-200 bg-sand-50 p-5 hover-lift hover:border-accent-300">
              <h3 class="font-semibold group-hover:text-accent-700">{p!.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-ink-600">{p!.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container-reach py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl font-semibold">Questions about giving</h2>
      <div class="mt-6 space-y-3">
        {questions.map((f) => (
          <details class="group rounded-2xl border border-sand-200 bg-white p-5 open:shadow-sm">
            <summary class="cursor-pointer list-none font-semibold text-ink-900">{f.q}</summary>
            <p class="mt-3 leading-relaxed text-ink-700">{f.a}</p>
          </details>
        ))}
      </div>
      <h2 class="mt-12 text-xl font-semibold">Other ways to help</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {others.map((w) => (
          <li><a href={`/donate/${w.slug}/`} class="btn-ghost">{w.short}</a></li>
        ))}
        <li><a href="/fundraising/" class="btn-ghost">Fundraise for us</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
