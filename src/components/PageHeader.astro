---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---
<section class="border-b border-sand-200 bg-sand-100/60">
  <div class="container-reach grid items-center gap-10 py-14 sm:py-16 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      {eyebrow && <p class="mb-4 text-sm font-semibold text-accent-700">{eyebrow}</p>}
      <h1 class="text-4xl font-medium leading-[1.08] sm:text-5xl lg:text-[3.5rem]">{title}</h1>
      {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">{lead}</p>}
    </div>
    <div class="hidden lg:col-span-5 lg:block">
      <img
        src="/images/banner-inner.jpg"
        alt=""
        width="795" height="427" loading="eager" decoding="async"
        class="aspect-[16/10] w-full rounded-2xl object-cover shadow-soft"
      />
    </div>
  </div>
</section>
