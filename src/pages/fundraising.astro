---
// Fundraising hub: the charity's events (from src/data/news.ts) and how to hold
// your own. Recent events are mostly around Marple and Marple Bridge (Stockport), which is
// also what local searches look for.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { news } from '../data/news';
import { site } from '../data/site';

const siteUrl = Astro.site ?? new URL('https://reach-children-uganda.org.uk');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fundraising for R.E.A.CH',
  url: new URL('/fundraising/', siteUrl).href,
  about: { '@id': new URL('/#organization', siteUrl).href },
  hasPart: news.map((n) => ({ '@type': 'Event', name: n.title, url: new URL(`/news/${n.slug}/`, siteUrl).href })),
};
---

<BaseLayout
  title="Fundraising events in Marple & Stockport"
  description="R.E.A.CH fundraising events in Marple, Marple Bridge and beyond — film nights, clothes swaps, tea and cake — and how to hold your own fundraiser for children in Uganda."
  schema={schema}
>
  <PageHeader
    eyebrow="Get involved"
    title="Fundraising for R.E.A.CH"
    lead="Around 30% of what R.E.A.CH raises comes from fundraising events — most recently around Marple and Marple Bridge."
  />

  <section class="container-reach py-16">
    <h2 class="text-2xl font-semibold sm:text-3xl">Our fundraising events</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {news.map((n) => (
        <a href={`/news/${n.slug}/`} class="group rounded-2xl border border-sand-200 bg-white p-6 hover-lift hover:border-accent-300">
          <p class="text-sm font-semibold uppercase tracking-wider text-accent-700">{n.eventDate}</p>
          <h3 class="mt-2 text-lg font-semibold group-hover:text-accent-700">{n.title}</h3>
          <p class="mt-1 text-sm text-ink-500">{n.venue}, {n.location}</p>
          <p class="mt-3 line-clamp-3 text-sm text-ink-600">{n.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-sand-200 bg-white">
    <div class="container-reach grid gap-10 py-16 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Hold your own fundraiser</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          A film night, a clothes swap, tea and cake — every event helps keep children in Uganda in
          school. Tell us what you're planning; we'd love to hear from you.
        </p>
        <p class="mt-4 leading-relaxed text-ink-700">
          R.E.A.CH is run entirely by unpaid volunteers, so what you raise goes to the education and
          care of the children we support.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact-us/" class="btn-primary">Tell us about your event</a>
          <a href={`mailto:${site.email}`} class="btn-ghost">Email us</a>
        </div>
      </div>
      <div class="rounded-3xl bg-sand-100/70 p-8">
        <h3 class="text-lg font-semibold">Prefer to give directly?</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/donate/sponsor-a-secondary-school-child/" class="font-semibold text-accent-700 hover:text-accent-800">Sponsor a secondary school child</a> — £20 a month</li>
          <li><a href="/donate/sponsor-a-primary-school-child/" class="font-semibold text-accent-700 hover:text-accent-800">Sponsor a primary school child</a> — £12.50 a month</li>
          <li><a href="/donate/school-uniform/" class="font-semibold text-accent-700 hover:text-accent-800">Give a school uniform</a> — £2 a month</li>
          <li><a href="/donate/gift-aid/" class="font-semibold text-accent-700 hover:text-accent-800">Add Gift Aid</a> — +25% at no cost to you</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
