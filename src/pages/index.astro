---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { news } from '../data/news';

// "Next event" banner. Events dated before the build day are left out here; the
// small script below the banner then hides an event once its day has passed, so
// nothing stale shows even if the site isn't rebuilt in between.
const toIso = (d: string) => {
  const parsed = new Date(`${d} 12:00 UTC`);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString().slice(0, 10);
};
const buildDay = new Date().toISOString().slice(0, 10);
const upcoming = news
  .map((n) => ({ ...n, iso: toIso(n.eventDate) }))
  .filter((n) => n.iso !== undefined && n.iso >= buildDay)
  .sort((a, b) => a.iso!.localeCompare(b.iso!));

const featured = projects.filter((p) => p.featured).slice(0, 3);

const stats = [
  { value: '1992', label: 'Founded in Bury, Lancashire' },
  { value: '£8–10k', label: 'Raised for children each year' },
  { value: '100%', label: 'Run by unpaid volunteer trustees' },
];

const sponsorship = [
  { amount: '£20', period: 'per month', text: 'Provides a secondary school child with food, accommodation and education.' },
  { amount: '£12.50', period: 'per month', text: 'Helps support a primary school child with their educational needs and care.' },
  { amount: '£2', period: 'per month', text: 'Provides a uniform and clothing.' },
];
---

<BaseLayout
  description="R.E.A.CH (Reaching East Africa's CHildren) is a UK charity that educates and cares for vulnerable children in Uganda. Sponsor a child from £2 a month — 100% volunteer-run, with minimal overheads."
>
  <!-- Hero -->
  <section>
    <div class="container-reach grid items-center gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-7">
        <p class="mb-6 flex items-center gap-2.5 text-sm font-semibold text-accent-700">
          <span class="h-2 w-2 rounded-full bg-gold-500"></span> Reaching East Africa's CHildren
        </p>
        <h1 class="text-5xl font-medium leading-[1.02] sm:text-6xl lg:text-7xl">
          Education is no weight to carry.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-700 sm:text-xl sm:leading-relaxed">
          R.E.A.CH helps to educate and care for vulnerable children in Uganda. We believe all
          children should have a childhood — and that a good education is the surest way out of poverty.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/donate" class="btn-primary">Sponsor a child</a>
          <a href="/about" class="btn-ghost">Find out more</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <img
          src="/images/BAO-child.gif"
          alt="A child supported by R.E.A.CH in Uganda"
          width="600" height="690" loading="eager" decoding="async"
          class="aspect-[5/6] w-full rounded-[2rem] object-cover shadow-lift"
          onerror="this.onerror=null;this.src='/images/placeholder.svg';this.classList.add('img-fallback');"
        />
      </div>
    </div>
  </section>

  <!-- Next event (hidden until the script confirms the event hasn't passed) -->
  {upcoming.length > 0 && (
    <section id="next-event" class="border-t border-sand-200 bg-accent-50" hidden>
      <div class="container-reach py-8">
        {upcoming.map((e) => (
          <div data-event-date={e.iso} hidden>
            <div class="flex flex-col items-center gap-6 sm:flex-row">
              {e.image && (
                <a href={`/news/${e.slug}/`} class="shrink-0">
                  <img
                    src={e.image}
                    alt={e.imageAlt ?? `Poster for ${e.title}`}
                    width="1065" height="1352" loading="lazy" decoding="async"
                    class="h-40 w-auto rounded-xl border border-sand-200 shadow-sm"
                  />
                </a>
              )}
              <div class="flex-1 text-center sm:text-left">
                <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">Next event · {e.eventDate}</p>
                <h2 class="mt-1 text-2xl font-semibold sm:text-3xl">{e.title}</h2>
                <p class="mt-1 text-ink-600">{e.venue}, {e.location}</p>
              </div>
              <div class="flex flex-wrap justify-center gap-3">
                {e.ticketUrl && (
                  <a href={e.ticketUrl} class="btn-primary" target="_blank" rel="noopener">Book tickets</a>
                )}
                <a href={`/news/${e.slug}/`} class="btn-ghost">Event details</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
  <script is:inline>
    (function () {
      var section = document.getElementById('next-event');
      if (!section) return;
      var today;
      try {
        // en-CA formats as YYYY-MM-DD; UK time so the banner lasts through the event day.
        today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
      } catch (err) {
        today = new Date().toISOString().slice(0, 10);
      }
      var items = section.querySelectorAll('[data-event-date]');
      for (var i = 0; i < items.length; i++) {
        if (items[i].getAttribute('data-event-date') >= today) {
          items[i].hidden = false;
          section.hidden = false;
          break;
        }
      }
    })();
  </script>

  <!-- Stats -->
  <section class="border-y border-sand-200 bg-white">
    <dl class="container-reach grid divide-y divide-sand-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {stats.map((s) => (
        <div class="flex flex-col-reverse py-8 text-center sm:px-8 sm:py-10">
          <dt class="mt-2 text-sm text-ink-600">{s.label}</dt>
          <dd class="font-display text-4xl font-medium tracking-tight text-ink-900 sm:text-5xl">
            {/^\d+%$/.test(s.value)
              ? <span class="num-up" data-to={parseInt(s.value, 10)} data-suffix="%">{s.value}</span>
              : s.value}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Intro -->
  <section class="container-reach py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl font-semibold sm:text-4xl">Who we are</h2>
        <div class="prose-reach mt-6">
          <p>
            R.E.A.CH (Reaching East Africa's Children) helps to educate and care for vulnerable
            children in Uganda. Our philosophy is that 'all children should have a childhood' and
            that 'education is no weight to carry.'
          </p>
          <p>
            We are proud of our minimal overheads and publish details of all the charity costs so
            our donors can be reassured that their money is being managed and spent in the most
            effective way.
          </p>
          <p>
            We operate through 'Trusted Representatives' in Uganda who identify the need and manage
            the projects on our behalf. Whilst our primary focus is education, we also fund a number
            of small projects which we hope will become sustainable in the future.
          </p>
        </div>
        <a href="/about" class="mt-6 inline-flex items-center gap-2 font-semibold text-accent-700 hover:text-accent-800">
          How R.E.A.CH works
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Sponsorship -->
      <div class="rounded-3xl border border-sand-200 bg-sand-100/60 p-8">
        <h3 class="text-xl font-semibold">What your support provides</h3>
        <p class="mt-2 text-sm text-ink-600">Every contribution goes directly to the children and projects we support.</p>
        <ul class="mt-6 space-y-4">
          {sponsorship.map((s) => (
            <li class="flex items-start gap-4 rounded-2xl bg-white p-4 shadow-sm">
              <div class="shrink-0 text-right">
                <span class="text-gradient-warm block font-display text-2xl font-bold">{s.amount}</span>
                <span class="text-xs text-ink-500">{s.period}</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-700">{s.text}</p>
            </li>
          ))}
        </ul>
        <a href="/donate" class="btn-primary mt-6 w-full">Ways to donate</a>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="border-t border-sand-200 bg-white">
    <div class="container-reach py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">Our work</p>
          <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Projects we support</h2>
        </div>
        <a href="/projects" class="btn-ghost">View all projects</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => (
          <a href={`/projects/${p.slug}`} class="group flex flex-col rounded-3xl border border-sand-200 bg-sand-50 p-6 hover-lift hover:border-accent-300">
            <h3 class="text-lg font-semibold group-hover:text-accent-700">{p.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{p.summary}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700">
              Read more
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-reach py-20">
    <div class="rounded-3xl bg-accent-700 px-8 py-16 text-center text-white sm:px-16 sm:py-20">
      <div>
        <h2 class="text-3xl font-medium text-white sm:text-5xl">Help a child stay in school</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-accent-50">
          With minimal overheads and trusted representatives on the ground, your donation reaches the
          children who need it most. Set up a regular gift or make a one-off donation today.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/donate" class="btn bg-white text-accent-800 hover:bg-sand-100">Donate now</a>
          <a href="/contact-us" class="btn border border-white/40 text-white hover:bg-white/10">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
